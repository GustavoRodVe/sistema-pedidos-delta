# Copie este archivo como .env y complete la contraseña del usuario de MySQL.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=delta_app
DB_PASSWORD=
DB_NAME=delta_pedidos

# Clave con la que se firma la cookie de sesión. Obligatoria en producción: use
# un texto largo y aleatorio. En desarrollo, si se deja vacía, se usa una clave de pruebas.
SESSION_SECRET=
# development en local. Con production la cookie de sesión es segura (solo HTTPS),
# se confía en el proxy del servicio de despliegue y SESSION_SECRET pasa a ser obligatoria.
NODE_ENV=development
# Conexión cifrada a MySQL: false en local, true para Aiven (con DB_CA) o
# sin-verificar como plan B cuando no se dispone del certificado.
DB_SSL=false
# Contenido del certificado ca.pem de Aiven. Puede ir en una sola línea con \n entre líneas.
DB_CA=
