<%- include('../partials/encabezado', { titulo: 'Pedidos' }) %>
    <h1>Pedidos</h1>
    <p class="subtitulo">Pedidos mayoristas de las farmacias, del más reciente al más antiguo.</p>
    <div class="barra">
      <form method="get" action="/pedidos" data-cargando="Filtrando pedidos...">
        <label class="oculto" for="estado">Filtrar por estado</label>
        <select id="estado" name="estado">
          <option value="">Todos los estados</option>
          <% ESTADOS.forEach(e => { %><option value="<%= e %>"<%= estado === e ? ' selected' : '' %>><%= e.charAt(0).toUpperCase() + e.slice(1) %></option><% }) %>
        </select>
        <label class="oculto" for="farmacia">Filtrar por farmacia</label>
        <select id="farmacia" name="farmacia">
          <option value="">Todas las farmacias</option>
          <% farmacias.forEach(f => { %><option value="<%= f.id_farmacia %>"<%= idFarmacia === f.id_farmacia ? ' selected' : '' %>><%= f.nombre %></option><% }) %>
        </select>
        <button class="boton secundario" type="submit">Filtrar</button>
        <% if (estado || idFarmacia) { %><a href="/pedidos">Quitar filtro</a><% } %>
      </form>
      <% if (tieneRol(ROLES.ADMIN, ROLES.VENTAS)) { %><a class="boton" href="/pedidos/nuevo">Nuevo pedido</a><% } %>
    </div>
    <% if (pedidos.length === 0) { %>
      <div class="vacio-bloque">
        <% if (estado || idFarmacia) { %>
          <p>No hay pedidos con los filtros seleccionados.</p>
          <a class="boton secundario" href="/pedidos">Ver todos los pedidos</a>
        <% } else { %>
          <p>Todavía no hay pedidos registrados.</p>
          <% if (tieneRol(ROLES.ADMIN, ROLES.VENTAS)) { %><a class="boton" href="/pedidos/nuevo">Registrar el primer pedido</a><% } %>
        <% } %>
      </div>
    <% } else { %>
    <table class="tabla-adaptable">
      <caption class="oculto">Listado de pedidos</caption>
      <thead>
        <tr><th scope="col">N°</th><th scope="col">Fecha</th><th scope="col">Farmacia</th><th scope="col">Estado</th><th scope="col" class="numero">Total (Bs)</th><th scope="col">Acciones</th></tr>
      </thead>
      <tbody>
      <% pedidos.forEach(p => { %>
      <tr>
        <td data-label="N°" class="principal"><a href="/pedidos/<%= p.id_pedido %>"><%= p.id_pedido %></a></td>
        <td data-label="Fecha"><%= p.fecha_pedido %></td>
        <td data-label="Farmacia"><%= p.farmacia %></td>
        <td data-label="Estado"><span class="estado <%= p.estado %>"><%= p.estado %></span></td>
        <td data-label="Total (Bs)" class="numero"><%= p.total.toFixed(2) %></td>
        <td data-label="Acciones" class="acciones"><a class="boton chico secundario" href="/pedidos/<%= p.id_pedido %>" aria-label="Ver el pedido <%= p.id_pedido %>">Ver</a></td>
      </tr>
      <% }) %>
      </tbody>
    </table>
    <div class="paginacion"><span><%= pedidos.length %> pedido(s)</span></div>
    <% } %>
<%- include('../partials/pie') %>
