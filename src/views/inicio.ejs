<%- include('partials/encabezado', { titulo: 'Inicio' }) %>
    <h1>Panel principal</h1>
    <p class="subtitulo">Resumen del día con datos obtenidos de la base de datos.</p>

    <div class="tarjetas">
      <% if (tieneRol(ROLES.ADMIN, ROLES.VENTAS)) { %>
      <a class="indicador" href="/farmacias">
        <div class="valor"><%= totalFarmacias %></div>
        <div class="etiqueta">Farmacias activas</div>
        <div class="texto">Ver el listado de farmacias clientes</div>
      </a>
      <% } else { %>
      <div class="indicador">
        <div class="valor"><%= totalFarmacias %></div>
        <div class="etiqueta">Farmacias activas</div>
        <div class="texto">Farmacias clientes del laboratorio</div>
      </div>
      <% } %>
      <a class="indicador" href="/medicamentos">
        <div class="valor"><%= totalMedicamentos %></div>
        <div class="etiqueta">Medicamentos en catálogo</div>
        <div class="texto">Ver precios mayoristas y stock</div>
      </a>
      <div class="indicador<%= stockBajo.length > 0 ? ' alerta-stock' : '' %>">
        <div class="valor"><%= stockBajo.length %></div>
        <div class="etiqueta">Con stock bajo</div>
        <div class="texto">Menos de <%= STOCK_MINIMO %> unidades disponibles</div>
      </div>
    </div>

    <div class="tarjetas">
      <a class="indicador" href="/pedidos?estado=pendiente">
        <div class="valor"><%= pedidosPorEstado.pendiente %></div>
        <div class="etiqueta">Pendientes</div>
        <div class="texto">Esperan ser despachados</div>
      </a>
      <a class="indicador" href="/pedidos?estado=despachado">
        <div class="valor"><%= pedidosPorEstado.despachado %></div>
        <div class="etiqueta">Despachados</div>
        <div class="texto">Salieron del almacén</div>
      </a>
      <a class="indicador" href="/pedidos?estado=entregado">
        <div class="valor"><%= pedidosPorEstado.entregado %></div>
        <div class="etiqueta">Entregados</div>
        <div class="texto">Recibidos por la farmacia</div>
      </a>
      <a class="indicador" href="/pedidos?estado=anulado">
        <div class="valor"><%= pedidosPorEstado.anulado %></div>
        <div class="etiqueta">Anulados</div>
        <div class="texto">Cancelados antes de despachar</div>
      </a>
    </div>

    <div class="columnas">
      <section class="tarjeta">
        <h2>Accesos rápidos</h2>
        <div class="accesos">
          <% if (tieneRol(ROLES.ADMIN, ROLES.VENTAS)) { %><a class="boton" href="/farmacias/nueva">Registrar farmacia</a><% } %>
          <% if (tieneRol(ROLES.ADMIN)) { %><a class="boton" href="/medicamentos/nuevo">Registrar medicamento</a><% } %>
          <% if (tieneRol(ROLES.ADMIN, ROLES.VENTAS)) { %><a class="boton secundario" href="/farmacias">Buscar farmacia</a><% } %>
          <% if (tieneRol(ROLES.ADMIN, ROLES.VENTAS)) { %><a class="boton" href="/pedidos/nuevo">Registrar pedido</a><% } %>
          <a class="boton secundario" href="/pedidos?estado=pendiente">Pedidos pendientes</a>
          <% if (tieneRol(ROLES.ADMIN)) { %><a class="boton secundario" href="/reportes/pedidos">Reporte de pedidos</a><% } %>
          <a class="boton secundario" href="/medicamentos">Ver medicamentos</a>
        </div>
      </section>
      <section class="tarjeta">
        <h2>Medicamentos con stock bajo</h2>
        <% if (stockBajo.length === 0) { %>
          <p class="vacio">Todos los medicamentos tienen stock suficiente.</p>
        <% } else { %>
          <ul class="lista-simple">
            <% stockBajo.forEach(m => { %>
            <li>
              <a href="/medicamentos/<%= m.id_medicamento %>"><%= m.nombre %></a>
              <span class="estado bajo">Stock bajo: <%= m.stock %></span>
            </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </div>
<%- include('partials/pie') %>
