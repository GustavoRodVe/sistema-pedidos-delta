<% const esNueva = modo === 'nueva'; %>
<%- include('../partials/encabezado', { titulo: esNueva ? 'Registrar farmacia' : 'Editar farmacia' }) %>
    <nav class="migas" aria-label="Ubicación"><a href="/farmacias">Farmacias</a> / <span><%= esNueva ? 'Nueva farmacia' : 'Editar' %></span></nav>
    <h1><%= esNueva ? 'Registrar farmacia' : 'Editar farmacia: ' + farmacia.nombre %></h1>
    <p class="subtitulo">Los campos marcados con <span class="obligatorio">*</span> son obligatorios.</p>
    <div class="alerta error resumen-errores" role="alert"<%= Object.keys(errores).length > 0 ? '' : ' hidden' %>>
      No se guardó la farmacia. Revise los campos marcados en rojo.
    </div>
    <div class="tarjeta">
      <form method="post" action="<%= esNueva ? '/farmacias' : '/farmacias/' + farmacia.id_farmacia + '/editar' %>" novalidate data-validar="farmacia" data-cargando="Guardando...">
        <div class="fila">
          <%- include('../partials/campo', { id: 'nombre', etiqueta: 'Nombre', valor: farmacia.nombre, errores, obligatorio: true, atributos: 'maxlength="100" autocomplete="organization"' }) %>
          <%- include('../partials/campo', { id: 'nit', etiqueta: 'NIT', valor: farmacia.nit, errores, obligatorio: true, ayuda: 'Solo números, de 7 a 20 dígitos.', atributos: 'maxlength="20" inputmode="numeric"' }) %>
        </div>
        <div class="fila">
          <%- include('../partials/campo', { id: 'responsable', etiqueta: 'Responsable', valor: farmacia.responsable, errores, ayuda: 'Opcional. Persona de contacto en la farmacia.', atributos: 'maxlength="100"' }) %>
          <%- include('../partials/campo', { id: 'telefono', etiqueta: 'Teléfono', valor: farmacia.telefono, errores, obligatorio: true, atributos: 'maxlength="20" inputmode="tel" type="tel"' }) %>
        </div>
        <div class="fila">
          <%- include('../partials/campo', { id: 'direccion', etiqueta: 'Dirección', valor: farmacia.direccion, errores, obligatorio: true, atributos: 'maxlength="150"' }) %>
          <%- include('../partials/campo', { id: 'zona', etiqueta: 'Zona', valor: farmacia.zona, errores, obligatorio: true, opciones: zonas.map(z => ({ valor: z, texto: z })) }) %>
        </div>
        <div class="acciones">
          <button class="boton" type="submit"><%= esNueva ? 'Guardar' : 'Guardar cambios' %></button>
          <a class="boton secundario" href="<%= esNueva ? '/farmacias' : '/farmacias/' + farmacia.id_farmacia %>">Cancelar</a>
        </div>
      </form>
    </div>
<%- include('../partials/pie') %>
