<% const esNuevo = modo === 'nuevo'; %>
<%- include('../partials/encabezado', { titulo: esNuevo ? 'Registrar medicamento' : 'Editar medicamento' }) %>
    <nav class="migas" aria-label="Ubicación"><a href="/medicamentos">Medicamentos</a> / <span><%= esNuevo ? 'Nuevo medicamento' : 'Editar' %></span></nav>
    <h1><%= esNuevo ? 'Registrar medicamento' : 'Editar medicamento: ' + medicamento.nombre %></h1>
    <p class="subtitulo">Los campos marcados con <span class="obligatorio">*</span> son obligatorios.</p>
    <div class="alerta error resumen-errores" role="alert"<%= Object.keys(errores).length > 0 ? '' : ' hidden' %>>
      No se guardó el medicamento. Revise los campos marcados en rojo.
    </div>
    <div class="tarjeta">
      <form method="post" action="<%= esNuevo ? '/medicamentos' : '/medicamentos/' + medicamento.id_medicamento + '/editar' %>" novalidate data-validar="medicamento" data-cargando="Guardando...">
        <div class="fila">
          <%- include('../partials/campo', { id: 'nombre', etiqueta: 'Nombre', valor: medicamento.nombre, errores, obligatorio: true, ayuda: 'Incluya la concentración, por ejemplo: Paracetamol 500 mg.', atributos: 'maxlength="100"' }) %>
          <%- include('../partials/campo', { id: 'presentacion', etiqueta: 'Presentación', valor: medicamento.presentacion, errores, obligatorio: true, ayuda: 'Ejemplo: Caja de 100 tabletas.', atributos: 'maxlength="80"' }) %>
        </div>
        <div class="fila">
          <%- include('../partials/campo', { id: 'id_categoria', etiqueta: 'Categoría', valor: medicamento.id_categoria, errores, obligatorio: true, opciones: categorias.map(c => ({ valor: c.id_categoria, texto: c.nombre })) }) %>
          <%- include('../partials/campo', { id: 'precio_mayorista', etiqueta: 'Precio mayorista (Bs)', valor: medicamento.precio_mayorista, errores, obligatorio: true, ayuda: 'Mayor que cero, con hasta dos decimales.', atributos: 'inputmode="decimal"' }) %>
        </div>
        <div class="fila">
          <%- include('../partials/campo', { id: 'stock', etiqueta: 'Stock', valor: medicamento.stock, errores, obligatorio: true, ayuda: 'Cantidad disponible en unidades de la presentación.', atributos: 'inputmode="numeric"' }) %>
        </div>
        <div class="acciones">
          <button class="boton" type="submit"><%= esNuevo ? 'Guardar' : 'Guardar cambios' %></button>
          <a class="boton secundario" href="<%= esNuevo ? '/medicamentos' : '/medicamentos/' + medicamento.id_medicamento %>">Cancelar</a>
        </div>
      </form>
    </div>
<%- include('../partials/pie') %>
