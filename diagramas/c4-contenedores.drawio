<mxfile host="app.diagrams.net" agent="draw.io">
  <diagram id="d1" name="Contenedores">
    <mxGraphModel dx="1100" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="&lt;b&gt;Diagrama de contenedores (C4 nivel 2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Sistema de Pedidos Mayoristas - Laboratorio Químico Delta&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="15" width="960" height="50" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Configura y supervisa la información del sistema: usuarios, medicamentos, categorías y reportes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Ejecutivo de ventas&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Atiende a las farmacias y registra sus pedidos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="415" y="95" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Encargado de almacén&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Controla el stock y la salida de los pedidos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="95" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;[Chrome, Edge o Firefox]&lt;br&gt;&lt;br&gt;Muestra las páginas HTML que genera la aplicación y envía los formularios." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#8A8A8A;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="290" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Sistema de Pedidos Mayoristas&lt;/b&gt; [Sistema de software]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;strokeWidth=1.5;fontSize=12;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="250" y="490" width="600" height="400" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;Aplicación web&lt;/b&gt;&lt;br&gt;[Contenedor: Node.js + Express, MVC con vistas EJS]&lt;br&gt;&lt;br&gt;Recibe las solicitudes, valida los datos, aplica las reglas del negocio y genera las páginas HTML." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="520" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;[Contenedor: MySQL 8]&lt;br&gt;&lt;br&gt;Guarda usuarios, roles, farmacias, categorías, medicamentos y pedidos." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="395" y="730" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="c10" value="Usa" style="endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#707070;strokeWidth=1.5;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value="Usa" style="endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#707070;strokeWidth=1.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
