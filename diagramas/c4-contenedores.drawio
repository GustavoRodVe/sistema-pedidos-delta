        <mxCell id="c13" value="Envía solicitudes y formularios&lt;br&gt;[HTTP]" style="endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#707070;strokeWidth=1.5;exitX=0.15;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
