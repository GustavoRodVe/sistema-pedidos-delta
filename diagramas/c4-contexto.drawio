        <mxCell id="c2" value="&lt;b&gt;Diagrama de contexto (C4 nivel 1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Sistema de Pedidos Mayoristas - Laboratorio Químico Delta&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="960" height="50" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Configura y supervisa la información del sistema: usuarios, medicamentos, categorías y reportes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Ejecutivo de ventas&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Atiende a las farmacias y registra sus pedidos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="385" y="100" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Encargado de almacén&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Controla el stock y la salida de los pedidos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="100" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Sistema de Pedidos Mayoristas&lt;/b&gt;&lt;br&gt;[Sistema de software]&lt;br&gt;&lt;br&gt;Registra los pedidos mayoristas de las farmacias y permite seguir su estado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="400" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="c7" value="Administra usuarios,&lt;br&gt;medicamentos y categorías;&lt;br&gt;consulta reportes" style="endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#707070;strokeWidth=1.5;" edge="1" parent="1" source="c3" target="c6"><mxGeometry x="-0.15" y="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c8" value="Registra farmacias y pedidos;&lt;br&gt;consulta su estado" style="endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#707070;strokeWidth=1.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell>
