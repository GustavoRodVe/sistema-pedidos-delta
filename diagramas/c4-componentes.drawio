        <mxCell id="c16" value="Piden y guardan datos" style="endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#707070;strokeWidth=1.5;" edge="1" parent="1" source="grp" target="c11"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell>
