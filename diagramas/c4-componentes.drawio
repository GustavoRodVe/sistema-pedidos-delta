<mxfile host="app.diagrams.net" agent="draw.io">
  <diagram id="d1" name="Componentes">
    <mxGraphModel dx="1040" dy="970" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="970" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="&lt;b&gt;Diagrama de componentes (C4 nivel 3) - Aplicación web&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="960" height="36" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;[Chrome, Edge o Firefox]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#8A8A8A;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Aplicación web&lt;/b&gt; [Contenedor: Node.js + Express]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;strokeWidth=1.5;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="980" height="520" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Rutas&lt;/b&gt;&lt;br&gt;[Componente: Express Router]&lt;br&gt;Reciben cada solicitud y la envían al controlador del módulo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D9DD5;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330" y="235" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="grp" value="&lt;b&gt;Controladores por módulo&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5D9DD5;dashed=1;arcSize=4;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="50" y="375" width="940" height="160" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Autenticación&lt;/b&gt;&lt;br&gt;[Componente: controlador y middleware]&lt;br&gt;Inicia y cierra sesión; verifica la sesión y el rol antes de entrar a cada módulo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D9DD5;fontSize=12;arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="174" height="115" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Usuarios&lt;/b&gt;&lt;br&gt;[Componente: controlador]&lt;br&gt;Registra y desactiva usuarios." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D9DD5;fontSize=12;arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="244" y="410" width="174" height="115" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;Farmacias&lt;/b&gt;&lt;br&gt;[Componente: controlador]&lt;br&gt;Valida y procesa el registro, la consulta, la edición y la desactivación de farmacias." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D9DD5;fontSize=12;arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="428" y="410" width="174" height="115" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Medicamentos&lt;/b&gt;&lt;br&gt;[Componente: controlador]&lt;br&gt;Administra medicamentos y categorías." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D9DD5;fontSize=12;arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="612" y="410" width="174" height="115" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;Pedidos&lt;/b&gt;&lt;br&gt;[Componente: controlador]&lt;br&gt;Registra pedidos, cambia su estado, descuenta el stock y genera el reporte." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D9DD5;fontSize=12;arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="796" y="410" width="174" height="115" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;Modelos&lt;/b&gt;&lt;br&gt;[Componente: acceso a datos]&lt;br&gt;Ejecutan consultas parametrizadas sobre rol, usuario, farmacia, categoria, medicamento, pedido y detalle_pedido." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D9DD5;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="595" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;Vistas EJS&lt;/b&gt;&lt;br&gt;[Componente: plantillas]&lt;br&gt;Generan el HTML de listados, formularios y mensajes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D9DD5;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="595" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;[Contenedor: MySQL 8]" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="130" y="760" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="c14" value="Solicitud HTTP (GET o POST)" style="endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#707070;strokeWidth=1.5;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
